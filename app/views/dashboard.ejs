<%- include('partials/header') %>

<section class="hero-card">
  <div class="hero-copy">
    <span class="hero-badge">Bảng điều khiển thư viện</span>
    <h2>Quản lý sách nhẹ nhàng,<br>mượn trả rõ ràng.</h2>
    <p>Theo dõi kho sách, hồ sơ độc giả và mọi phiếu mượn trong cùng một không gian làm việc.</p>
    <div class="button-row">
      <a class="btn btn-light" href="/loans/new">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        Lập phiếu mượn
      </a>
      <a class="btn btn-outline-light" href="/books/new">Thêm sách mới</a>
    </div>
  </div>
  <div class="hero-visual">
    <p class="hero-kicker">Sách sẵn sàng cho mượn</p>
    <div class="hero-percentage"><%= availablePercent %><span>%</span></div>
    <progress class="progress progress-inverse" value="<%= availablePercent %>" max="100" aria-label="Tỷ lệ sách sẵn sàng">
      <%= availablePercent %>%
    </progress>
    <p class="hero-caption">
      <strong><%= stats.available_copies %></strong> trên <strong><%= stats.total_copies %></strong> bản sao còn trong kho
    </p>
  </div>
</section>

<section class="stats-grid" aria-label="Số liệu tổng quan">
  <article class="stat-card">
    <div class="stat-icon stat-icon-teal" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H19v16H6.5A1.5 1.5 0 0 0 5 20.5v-16Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
        <path d="M5 20.5A1.5 1.5 0 0 0 6.5 22H19v-3" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      </svg>
    </div>
    <div>
      <p class="stat-label">Đầu sách</p>
      <p class="stat-value"><%= stats.book_titles %></p>
      <p class="stat-meta"><%= stats.total_copies %> bản sao trong kho</p>
    </div>
  </article>

  <article class="stat-card">
    <div class="stat-icon stat-icon-blue" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="1.7"/>
        <path d="M3.5 20c.3-3.4 2.5-5.5 5.5-5.5s5.2 2.1 5.5 5.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
        <circle cx="17" cy="9" r="2.2" stroke="currentColor" stroke-width="1.7"/>
        <path d="M15.5 14.8c2.8-.4 4.8 1.4 5 4.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
      </svg>
    </div>
    <div>
      <p class="stat-label">Độc giả</p>
      <p class="stat-value"><%= stats.reader_count %></p>
      <p class="stat-meta">Hồ sơ đang hoạt động</p>
    </div>
  </article>

  <article class="stat-card">
    <div class="stat-icon stat-icon-amber" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M4 8h13l-3-3M20 16H7l3 3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M4 8l3 3M20 16l-3-3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div>
      <p class="stat-label">Đang mượn</p>
      <p class="stat-value"><%= stats.active_loans %></p>
      <p class="stat-meta">Phiếu chưa được trả</p>
    </div>
  </article>

  <article class="stat-card <%= stats.overdue_loans > 0 ? 'stat-card-alert' : '' %>">
    <div class="stat-icon stat-icon-rose" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7"/>
        <path d="M12 7.5V12l3 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div>
      <p class="stat-label">Quá hạn</p>
      <p class="stat-value"><%= stats.overdue_loans %></p>
      <p class="stat-meta"><%= stats.overdue_loans > 0 ? 'Cần xử lý ưu tiên' : 'Không có phiếu quá hạn' %></p>
    </div>
  </article>
</section>

<section class="content-grid">
  <div class="panel">
    <header class="panel-header">
      <div>
        <h3>Phiếu mượn đang lưu hành</h3>
        <p>Ưu tiên các phiếu sắp đến hạn hoặc đã quá hạn.</p>
      </div>
      <a class="text-link" href="/loans?status=active">Xem tất cả</a>
    </header>

    <% if (recentLoans.length === 0) { %>
      <div class="empty-state">
        <span class="empty-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H19v16H6.5A1.5 1.5 0 0 0 5 20.5v-16Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
            <path d="m8.5 12 2.2 2.2 4.5-4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <h4>Chưa có phiếu mượn nào</h4>
        <p>Khi độc giả mượn sách, phiếu mượn sẽ xuất hiện tại đây.</p>
        <a class="btn btn-secondary btn-sm" href="/loans/new">Lập phiếu đầu tiên</a>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Độc giả</th>
              <th>Đầu sách</th>
              <th>Hạn trả</th>
              <th>Trạng thái</th>
            </tr>
          </thead>
          <tbody>
            <% recentLoans.forEach((loan) => { %>
              <tr>
                <td>
                  <div class="person-cell">
                    <span class="avatar avatar-sm"><%= initials(loan.full_name) %></span>
                    <div>
                      <strong><%= loan.full_name %></strong>
                      <span><%= loan.email %></span>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="book-cell">
                    <strong><%= loan.title %></strong>
                    <span><%= loan.author %></span>
                  </div>
                </td>
                <td class="<%= loan.overdue ? 'text-danger' : '' %>"><%= formatDate(loan.due_date) %></td>
                <td>
                  <% if (loan.overdue) { %>
                    <span class="badge badge-danger">Quá hạn</span>
                  <% } else { %>
                    <span class="badge badge-info">Đang mượn</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <div class="side-stack">
    <% if (stats.overdue_loans > 0) { %>
      <section class="callout callout-warning">
        <span class="callout-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M12 4 21 20H3L12 4Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
            <path d="M12 9.5v4M12 16.8v.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </span>
        <div>
          <h3>Có <%= stats.overdue_loans %> phiếu quá hạn</h3>
          <p>Kiểm tra danh sách và liên hệ độc giả để thu hồi sách.</p>
          <a class="text-link" href="/loans?status=overdue">Xem phiếu quá hạn</a>
        </div>
      </section>
    <% } %>

    <section class="panel panel-compact">
      <header class="panel-header">
        <div>
          <h3>Thao tác nhanh</h3>
          <p>Những công việc thường gặp.</p>
        </div>
      </header>
      <div class="quick-list">
        <a class="quick-link" href="/loans/new">
          <span class="quick-icon quick-icon-teal" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M4 8h13l-3-3M20 16H7l3 3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span><strong>Lập phiếu mượn</strong><small>Cho độc giả mượn sách</small></span>
          <span class="chevron" aria-hidden="true">›</span>
        </a>
        <a class="quick-link" href="/books/new">
          <span class="quick-icon quick-icon-blue" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H19v16H6.5A1.5 1.5 0 0 0 5 20.5v-16Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
              <path d="M12 7v6M9 10h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            </svg>
          </span>
          <span><strong>Thêm đầu sách</strong><small>Bổ sung sách vào kho</small></span>
          <span class="chevron" aria-hidden="true">›</span>
        </a>
        <a class="quick-link" href="/readers/new">
          <span class="quick-icon quick-icon-amber" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <circle cx="10" cy="8" r="3" stroke="currentColor" stroke-width="1.7"/>
              <path d="M4.5 20c.3-3.4 2.5-5.5 5.5-5.5s5.2 2.1 5.5 5.5M17 8h4M19 6v4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            </svg>
          </span>
          <span><strong>Thêm độc giả</strong><small>Tạo hồ sơ độc giả mới</small></span>
          <span class="chevron" aria-hidden="true">›</span>
        </a>
      </div>
    </section>
  </div>
</section>

<%- include('partials/footer') %>

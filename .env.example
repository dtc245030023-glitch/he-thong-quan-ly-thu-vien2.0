# Sao chép file này thành .env, sau đó thay TẤT CẢ giá trị CHANGE_ME
# bằng mật khẩu ngẫu nhiên, dài tối thiểu 32 ký tự.
#
# PowerShell (tương thích cả Windows PowerShell 5.1):
#   Copy-Item .env.example .env
#   $bytes = New-Object byte[] 32
#   ([Security.Cryptography.RandomNumberGenerator]::Create()).GetBytes($bytes)
#   ($bytes | ForEach-Object { $_.ToString('x2') }) -join ''
#
# Linux/macOS/Git Bash:
#   cp .env.example .env
#   openssl rand -hex 32

POSTGRES_DB=library_db
POSTGRES_USER=library_admin
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD

PGADMIN_DEFAULT_EMAIL=admin@library.vn
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD

# Tài khoản quản trị Grafana (dùng thêm một mật khẩu ngẫu nhiên khác).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_PASSWORD

# URL công khai của Grafana. Phải khớp cổng Nginx bên dưới. Ví dụ khi
# HTTP_PORT=8080 thì đặt http://localhost:8080/grafana/
GRAFANA_ROOT_URL=http://localhost/grafana/

# Cổng public của Nginx. Đổi nếu cổng 80/443 đã bị chiếm trên máy.
HTTP_PORT=80
HTTPS_PORT=443

TZ=Asia/Ho_Chi_Minh
